@model RaceDay.Models.Event

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" type="datetime-local" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select" asp-items="Html.GetEnumSelectList<RaceDay.Models.EventType>()"></select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
</div>
