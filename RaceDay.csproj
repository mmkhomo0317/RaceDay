<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="RaceDayTests\obj\**" />
	  <Content Remove="RaceDayTests\obj\**" />
	  <EmbeddedResource Remove="RaceDayTests\obj\**" />
	  <None Remove="RaceDayTests\obj\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.91.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
		<PackageReference Include="xunit.abstractions" Version="2.0.3" />
	</ItemGroup>

</Project>